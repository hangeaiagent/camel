FROM node:18-alpine

# 设置工作目录
WORKDIR /app

# 安装系统依赖
RUN apk add --no-cache git

# 复制package文件
COPY package*.json ./

# 安装依赖
RUN npm ci

# 复制应用代码
COPY . .

# 创建非root用户
RUN addgroup -g 1001 -S nodejs \
    && adduser -S react -u 1001 \
    && chown -R react:nodejs /app
USER react

# 暴露端口
EXPOSE 3000

# 启动命令
CMD ["npm", "start"]
